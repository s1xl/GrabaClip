#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     GC_V1,GC_V2,GC_V3,0
 PRODUCTVERSION  GC_V1,GC_V2,GC_V3,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "GrabaClip (open source)"
      VALUE "FileDescription",  GC_DESC
      VALUE "FileVersion",      GC_VSTR
      VALUE "InternalName",     GC_NAME
      VALUE "LegalCopyright",   "MIT License - s1xl"
      VALUE "OriginalFilename", GC_FILE
      VALUE "ProductName",      "GrabaClip"
      VALUE "ProductVersion",   GC_VSTR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
